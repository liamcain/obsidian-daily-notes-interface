{
  "name": "obsidian-daily-notes-interface",
  "version": "0.9.4",
  "description": "Interface for creating daily notes in Obsidian",
  "author": "liamcain",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liamcain/obsidian-daily-notes-interface"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint . --ext .ts",
    "build": "pnpm run lint && tsdown",
    "build:ci": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "tslib": "2.5.0"
  },
  "peerDependencies": {
    "obsidian": ">=1.0.0"
  },
  "devDependencies": {
    "@types/moment": "2.13.0",
    "@typescript-eslint/eslint-plugin": "4.20.0",
    "@typescript-eslint/parser": "4.20.0",
    "eslint": "7.23.0",
    "moment": "2.29.1",
    "moment-timezone": "0.5.33",
    "obsidian": "obsidianmd/obsidian-api#master",
    "tsdown": "0.22.0",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
